
{
  "rewrites": [
    {
      "source": "/capital",
      "destination": "/index.html"
    },
    {
      "source": "/capital/",
      "destination": "/index.html"
    },
    {
      "source": "/capital/assets/:path*",
      "destination": "/assets/:path*"
    },
    {
      "source": "/capital/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/:path*",
      "destination": "/index.html"
    }
  ]
}
